{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "isolatedModules": true,
    "paths": {
      "@demo": [
        "./src/demo/demoApi.ts"
      ]
    },
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "../server/src/types.ts"
  ]
}